#!/bin/bash

# --- Configuration & Arguments ---
DEFAULT_LOG="/var/log/pm/pm.log"
FILE="$DEFAULT_LOG"
SPAN=""
MODE="both"
COST_PER_KWH=0.25

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --span=*)
            SPAN="${1#*=}"
            shift
            ;;
        --span)
            [[ "$#" -ge 2 ]] || { echo "Error: --span requires an argument." >&2; exit 2; }
            SPAN="$2"
            shift 2
            ;;
        --cost|--power|--both)
            MODE="${1#--}"
            shift
            ;;
        -h|--help)
            echo "Usage: $0 [--span=<interval>] [--cost | --power | --both] [logfile]"
            exit 0
            ;;
        --*)
            echo "Error: Unknown option: $1" >&2
            exit 2
            ;;
        *)
            FILE="$1"
            shift
            ;;
    esac
done

[[ -f "$FILE" ]] || { echo "Error: File $FILE not found." >&2; exit 1; }

# --- Time Range Calculation ---
TERM_WIDTH=132
TERM_HEIGHT=30
TARGET_BINS=60

START_EPOCH=""
END_EPOCH=$(date +%s)

if [[ -n "$SPAN" ]]; then
    case "${SPAN,,}" in
        hour)  START_EPOCH=$(date -d "1 hour ago" +%s) ;;
        day)   START_EPOCH=$(date -d "1 day ago" +%s) ;;
        week)  START_EPOCH=$(date -d "1 week ago" +%s) ;;
        month) START_EPOCH=$(date -d "1 month ago" +%s) ;;
        ytd|year-to-date)
            START_EPOCH=$(date -d "$(date +%Y)-01-01 00:00:00" +%s)
            ;;
        *)
            echo "Error: Unknown span '$SPAN'. Use hour, day, week, month, or ytd." >&2
            exit 2
            ;;
    esac
else
    FIRST_LINE=$(awk -F, '$1 ~ /^[0-9]{4}-/ { print; exit }' "$FILE")
    LAST_LINE=$(awk -F, '$1 ~ /^[0-9]{4}-/ { line=$0 } END { if (line != "") print line }' "$FILE")

    [[ -n "$FIRST_LINE" && -n "$LAST_LINE" ]] || {
        echo "Error: No data rows found in $FILE." >&2
        exit 1
    }

    START_EPOCH=$(awk -F, '{
        dt=substr($1,1,19)
        gsub(/[-T:]/, " ", dt)
        print mktime(dt)
    }' <<< "$FIRST_LINE")

    # Include the last recorded sample.
    END_EPOCH=$(awk -F, '{
        dt=substr($1,1,19)
        gsub(/[-T:]/, " ", dt)
        print mktime(dt) + 1
    }' <<< "$LAST_LINE")
fi

DURATION=$(( END_EPOCH - START_EPOCH ))
(( DURATION < 60 )) && DURATION=60
BIN_WIDTH=$(( DURATION / TARGET_BINS ))
(( BIN_WIDTH < 1 )) && BIN_WIDTH=1

# --- Data Processing (AWK) ---
# Column 3: instantaneous power in watts.
# Column 6: meter cumulative energy in kWh.
#
# Power is averaged into display bins. Cost is derived independently from
# the meter's cumulative-energy counter, so changing TARGET_BINS does not
# change the total cost. If the meter energy counter resets, a decrease is
# treated as a reset and accumulation continues from the new value.
TMP_DATA=$(mktemp)
trap 'rm -f "$TMP_DATA"' EXIT

awk -F, \
    -v start="$START_EPOCH" \
    -v end="$END_EPOCH" \
    -v bw="$BIN_WIDTH" \
    -v rate="$COST_PER_KWH" '
BEGIN { OFS=" " }

$1 !~ /^[0-9]{4}-/ { next }

{
    dt = substr($1, 1, 19)
    gsub(/[-T:]/, " ", dt)
    epoch = mktime(dt)

    if (epoch < start || epoch >= end)
        next

    watts = $3 + 0
    energy = $6 + 0

    # Accumulate energy from raw samples, independently of display bins.
    if (!have_prev) {
        prev_energy = energy
        have_prev = 1
    } else {
        delta = energy - prev_energy
        if (delta >= 0)
            used_kwh += delta
        else
            used_kwh += energy   # cumulative counter reset
        prev_energy = energy
    }

    bin = int((epoch - start) / bw)
    btime = start + bin * bw

    sum_w[bin] += watts
    cnt_w[bin]++

    # Keep cumulative cost at the latest raw sample in each display bin.
    cost[bin] = used_kwh * rate
    time_of_bin[bin] = btime
}

END {
    n = asorti(time_of_bin, keys, "@ind_num_asc")
    for (i = 1; i <= n; i++) {
        b = keys[i]
        avg_w = sum_w[b] / cnt_w[b]
        cmd = "date -d @" time_of_bin[b] " +%Y-%m-%dT%H:%M:%S"
        cmd | getline t
        close(cmd)
        print t, avg_w, cost[b]
    }
}
' "$FILE" > "$TMP_DATA"

[[ -s "$TMP_DATA" ]] || {
    echo "Error: No samples found in the selected time range." >&2
    exit 1
}

# --- Visualization (Gnuplot) ---
SPAN_LABEL=${SPAN:-whole file}

if [[ "$MODE" == "both" ]]; then
    gnuplot <<EOF
        set xdata time; set timefmt '%Y-%m-%dT%H:%M:%S';
        set title 'Energy Usage: $SPAN_LABEL ($FILE)';
        set xlabel 'Time'; set ylabel '\$ Cumulative';
        set key outside bottom center horizontal;
        set y2label '* (Watts/Power)'; set ytics nomirror; set y2tics;
        set term dumb size $TERM_WIDTH,$TERM_HEIGHT ansi;
        plot '$TMP_DATA' using 1:3 with points pt '\$' title 'Cost (\$)', \
             '' using 1:2 axis x1y2 with lines title 'Power (*)'
EOF

elif [[ "$MODE" == "cost" ]]; then
    gnuplot <<EOF
        set xdata time; set timefmt '%Y-%m-%dT%H:%M:%S';
        set title 'Cumulative Cost: $SPAN_LABEL ($FILE)';
        set xlabel 'Time'; set ylabel '\$ Cumulative';
        set term dumb size $TERM_WIDTH,$TERM_HEIGHT ansi;
        plot '$TMP_DATA' using 1:3 with lines title 'Cost (\$)'
EOF

elif [[ "$MODE" == "power" ]]; then
    gnuplot <<EOF
        set xdata time; set timefmt '%Y-%m-%dT%H:%M:%S';
        set title 'Power over Time: $SPAN_LABEL ($FILE)';
        set xlabel 'Time'; set ylabel '* (Watts)';
        set term dumb size $TERM_WIDTH,$TERM_HEIGHT ansi;
        plot '$TMP_DATA' using 1:2 with lines title 'Power (*)'
EOF
fi
