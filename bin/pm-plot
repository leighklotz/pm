#!/bin/bash

# --- Configuration & Arguments ---
LOG_DIR="/var/log/pm"
LOG_GLOB="pm.log*"

SPAN=""
MODE="both"
COST_PER_KWH=0.25

while (( $# > 0 )); do
    case "$1" in
        --span=*)
            SPAN="${1#*=}"
            shift
            ;;
        --span)
            (( $# >= 2 )) || {
                echo "Error: --span requires an argument." >&2
                exit 2
            }
            SPAN="$2"
            shift 2
            ;;
        --cost|--power|--both)
            MODE="${1#--}"
            shift
            ;;
        -h|--help)
            echo "Usage: $0 [--span=<interval>] [--cost | --power | --both]"
            exit 0
            ;;
        --*)
            echo "Error: Unknown option: $1" >&2
            exit 2
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            exit 2
            ;;
    esac
done

# --- Find Logs, Oldest to Newest ---
#
# Supports:
#
#   pm.log
#   pm.log.1
#   pm.log.2
#   pm.log.3.gz
#   ...
#
# Files are sorted by modification time.  Plain files are read with cat;
# gzip-compressed files are read with gzip -cd.

mapfile -t LOG_FILES < <(
    find "$LOG_DIR" \
        -maxdepth 1 \
        -type f \
        -name "$LOG_GLOB" \
        -printf '%T@ %p\n' |
    sort -n |
    cut -d' ' -f2-
)

(( ${#LOG_FILES[@]} > 0 )) || {
    echo "Error: No log files found in $LOG_DIR matching $LOG_GLOB" >&2
    exit 1
}

# Emit all logs as one logical stream.
read_logs() {
    local file

    for file in "${LOG_FILES[@]}"; do
        case "$file" in
            *.gz)
                gzip -cd -- "$file"
                ;;
            *)
                cat -- "$file"
                ;;
        esac
    done
}

# --- Plot Configuration ---
TERM_WIDTH=132
TERM_HEIGHT=30
TARGET_BINS=60

# --- Time Range Calculation ---
START_EPOCH=""
END_EPOCH=$(date +%s)

if [[ -n "$SPAN" ]]; then
    case "${SPAN,,}" in
        hour)
            START_EPOCH=$(date -d "1 hour ago" +%s)
            ;;
        day)
            START_EPOCH=$(date -d "1 day ago" +%s)
            ;;
        week)
            START_EPOCH=$(date -d "1 week ago" +%s)
            ;;
        month)
            START_EPOCH=$(date -d "1 month ago" +%s)
            ;;
        ytd|year-to-date)
            START_EPOCH=$(date -d "$(date +%Y)-01-01 00:00:00" +%s)
            ;;
        *)
            echo "Error: Unknown span '$SPAN'." >&2
            echo "Use: hour, day, week, month, or ytd." >&2
            exit 2
            ;;
    esac
else
    FIRST_LINE=$(
        read_logs |
        awk -F, '
            $1 ~ /^[0-9]{4}-/ {
                print
                exit
            }
        '
    )

    LAST_LINE=$(
        read_logs |
        awk -F, '
            $1 ~ /^[0-9]{4}-/ {
                line=$0
            }
            END {
                if (line != "")
                    print line
            }
        '
    )

    [[ -n "$FIRST_LINE" && -n "$LAST_LINE" ]] || {
        echo "Error: No data rows found in log files." >&2
        exit 1
    }

    START_EPOCH=$(
        awk -F, '{
            dt=substr($1,1,19)
            gsub(/[-T:]/, " ", dt)
            print mktime(dt)
        }' <<< "$FIRST_LINE"
    )

    END_EPOCH=$(
        awk -F, '{
            dt=substr($1,1,19)
            gsub(/[-T:]/, " ", dt)
            print mktime(dt) + 1
        }' <<< "$LAST_LINE"
    )
fi

DURATION=$(( END_EPOCH - START_EPOCH ))
(( DURATION < 60 )) && DURATION=60

BIN_WIDTH=$(( DURATION / TARGET_BINS ))
(( BIN_WIDTH < 1 )) && BIN_WIDTH=1

# --- Data Processing ---
#
# CSV fields:
#
#   1 timestamp
#   2 plug
#   3 power_w
#   4 voltage_v
#   5 current_a
#   6 energy_kwh
#
# Header lines may occur anywhere in any rotated log. A valid data row
# starts with a four-digit year followed by "-".
#
# Power is averaged into display bins.
#
# Cost is derived directly from the meter's cumulative energy counter,
# so changing TARGET_BINS changes only plot resolution, not total cost.
#
# Blank lines are inserted between widely separated populated bins so
# gnuplot does not draw misleading lines across large logging gaps.

TMP_DATA=$(mktemp)
trap 'rm -f "$TMP_DATA"' EXIT

read_logs |
awk -F, \
    -v start="$START_EPOCH" \
    -v end="$END_EPOCH" \
    -v bw="$BIN_WIDTH" \
    -v rate="$COST_PER_KWH" '

BEGIN {
    OFS=" "
}

# Ignore headers, blank lines, and malformed/non-data rows.
$1 !~ /^[0-9]{4}-/ {
    next
}

{
    dt = substr($1, 1, 19)
    gsub(/[-T:]/, " ", dt)
    epoch = mktime(dt)

    if (epoch < start || epoch >= end)
        next

    watts = $3 + 0
    energy = $6 + 0

    # First valid energy reading in the selected range is the zero-cost
    # baseline for this plot.
    if (!have_first_energy) {
        first_energy = energy
        have_first_energy = 1
    }

    bin = int((epoch - start) / bw)
    btime = start + bin * bw

    sum_w[bin] += watts
    count_w[bin]++

    # Keep the latest cumulative energy reading in each display bin.
    last_energy[bin] = energy
    time_of_bin[bin] = btime
}

END {
    if (!have_first_energy)
        exit

    n = asorti(time_of_bin, keys, "@ind_num_asc")
    have_prev_bin = 0

    for (i = 1; i <= n; i++) {
        b = keys[i]

        avg_w = sum_w[b] / count_w[b]

        used_kwh = last_energy[b] - first_energy
        if (used_kwh < 0)
            used_kwh = 0

        running_cost = used_kwh * rate

        # Break plotted lines across substantial gaps in the log.
        if (have_prev_bin && (b - prev_bin) > 2)
            print ""

        cmd = "date -d @" time_of_bin[b] " +%Y-%m-%dT%H:%M:%S"
        cmd | getline t
        close(cmd)

        print t, avg_w, running_cost

        prev_bin = b
        have_prev_bin = 1
    }
}
' > "$TMP_DATA"

[[ -s "$TMP_DATA" ]] || {
    echo "Error: No samples found in the selected time range." >&2
    exit 1
}

# --- Visualization ---
SPAN_LABEL=${SPAN:-all logs}
LOG_LABEL="$LOG_DIR/$LOG_GLOB"

case "$MODE" in
    both)
        gnuplot <<EOF
set xdata time
set timefmt '%Y-%m-%dT%H:%M:%S'
set title 'Energy Usage: $SPAN_LABEL ($LOG_LABEL)'
set xlabel 'Time'
set ylabel '\$ Cumulative'
set key outside bottom center horizontal
set y2label '* (Watts/Power)'
set ytics nomirror
set y2tics
set term dumb size $TERM_WIDTH,$TERM_HEIGHT ansi

plot '$TMP_DATA' using 1:3 with points pt '\$' title 'Cost (\$)', \
     '' using 1:2 axis x1y2 with lines title 'Power (*)'
EOF
        ;;

    cost)
        gnuplot <<EOF
set xdata time
set timefmt '%Y-%m-%dT%H:%M:%S'
set title 'Cumulative Cost: $SPAN_LABEL ($LOG_LABEL)'
set xlabel 'Time'
set ylabel '\$ Cumulative'
set term dumb size $TERM_WIDTH,$TERM_HEIGHT ansi

plot '$TMP_DATA' using 1:3 with lines title 'Cost (\$)'
EOF
        ;;

    power)
        gnuplot <<EOF
set xdata time
set timefmt '%Y-%m-%dT%H:%M:%S'
set title 'Power over Time: $SPAN_LABEL ($LOG_LABEL)'
set xlabel 'Time'
set ylabel '* (Watts)'
set term dumb size $TERM_WIDTH,$TERM_HEIGHT ansi

plot '$TMP_DATA' using 1:2 with lines title 'Power (*)'
EOF
        ;;
esac
