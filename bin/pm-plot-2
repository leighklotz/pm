#!/bin/bash

# --- Configuration & Arguments ---
DEFAULT_LOG="/var/log/pm/pm.log"
FILE="$DEFAULT_LOG"
SPAN=""
MODE="both"

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --span=*|--)
            if [[ "$1" == "--span=*" ]]; then SPAN="${1#*=}"; else SPAN="$2"; shift; fi ;;
        --cost|--power|--both) MODE="${1#--}" ; shift ;;
        -h|--help) echo "Usage: $0 [--span=<interval>] [--cost | --power | --both] [logfile]"; exit 0 ;;
        *) FILE="$1"; shift ;;
    esac
done

[ ! -f "$FILE" ] && { echo "Error: File $FILE not found."; exit 1; }

# --- Time Range Calculation ---
TERM_WIDTH=132
TERM_HEIGHT=30
TARGET_BINS=60

START_EPOCH=""
END_EPOCH=$(date +%s)

if [ -n "$SPAN" ]; then
    case "${SPAN,,}" in
        hour)  START_EPOCH=$(date -d "1 hour ago" +%s) ;;
        day)   START_EPOCH=$(date -d "1 day ago" +%s) ;;
        week)  START_EPOCH=$(date -d "1 week ago" +%s) ;;
        month) START_EPOCH=$(date -d "1 month ago" +%s) ;;
        ytd|year-to-date) START_EPOCH=$(date -d "$(date +%Y)-01-01 00:00:00" +%s) ;;
    esac
else
    START_EPOCH=$(tail -n +2 "$FILE" | head -n 1 | awk -F, '{dt=substr($1,1,19); gsub(/[-T:]/, " ", dt); print mktime(dt)}')
    END_EPOCH=$(tail -n 1 "$FILE" | awk -F, '{dt=substr($1,1,19); gsub(/[-T:]/, " ", dt); print mktime(dt)}')
fi

[ -z "$START_EPOCH" ] && START_EPOCH=0
DURATION=$(( END_EPOCH - START_EPOCH ))
[ $DURATION -lt 60 ] && DURATION=60
BIN_WIDTH=$(( DURATION / TARGET_BINS ))

# --- Data Processing (AWK) ---
TMP_DATA=$(mktemp)
awk -F, -v start="$START_EPOCH" -v end="$END_EPOCH" -v bw="$BIN_WIDTH" '
BEGIN { OFS=" " }
{
    dt = substr($1, 1, 19); gsub(/[-T:]/, " ", dt); epoch = mktime(dt);
    if (epoch < start || epoch >= end) next;
    bin = int(epoch / bw) * bw; sum[bin] += $3; cnt[bin]++;
}
END {
    n = asorti(sum, keys);
    running_cost = 0;
    for (i=1; i<=n; i++) {
        b = keys[i]; avg_w = sum[b]/cnt[b];
        bin_kwh = (avg_w * bw) / 3600000; running_cost += bin_kwh * 0.25;
        cmd = "date -d @" b " +%Y-%m-%dT%H:%M:%S"; cmd | getline t; close(cmd);
        print t, avg_w, running_cost;
    }
}' "$FILE" > "$TMP_DATA"

# --- Visualization (Gnuplot) ---
SPAN_LABEL=${SPAN:-whole file}

# We use a heredoc <<EOF so we can write clean gnuplot code.
# Note: Because we are NOT quoting EOF, shell variables like $TERM_WIDTH 
# will be expanded correctly into the gnuplot script.
if [[ "$MODE" == "both" ]]; then
    gnuplot <<EOF
        set xdata time; set timefmt '%Y-%m-%dT%H:%M:%S';
        set title 'Energy Usage: $SPAN_LABEL ($FILE)';
        set xlabel 'Time'; set ylabel '$ Cumulative';
        set key outside bottom center horizontal;
        set y2label '* (Watts/Power)'; set ytics nomirror; set y2tics;
        set term dumb size $TERM_WIDTH,$TERM_HEIGHT ansi;
        plot '$TMP_DATA' using 1:3 with points pt '\$' title 'Cost ($)', \
             '' using 1:2 axis x1y2 with lines title 'Power (*)'
EOF

elif [[ "$MODE" == "cost" ]]; then
    gnuplot <<EOF
        set xdata time; set timefmt '%Y-%m-%dT%H:%M:%S';
        set title 'Cumulative Cost: $SPAN_LABEL ($FILE)';
        set xlabel 'Time'; set ylabel '$ Cumulative';
        set term dumb size $TERM_WIDTH,$TERM_HEIGHT ansi;
        plot '$TMP_DATA' using 1:3 with lines title 'Cost ($)'
EOF

elif [[ "$MODE" == "power" ]]; then
    gnuplot <<EOF
        set xdata time; set timefmt '%Y-%m-%dT%H:%M:%S';
        set title 'Power over Time: $SPAN_LABEL ($FILE)';
        set xlabel 'Time'; set ylabel '* (Watts)';
        set term dumb size $TERM_WIDTH,$TERM_HEIGHT ansi;
        plot '$TMP_DATA' using 1:2 with lines title 'Power (*)'
EOF
fi

rm "$TMP_DATA"
